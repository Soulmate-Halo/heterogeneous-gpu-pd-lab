+                if (o.suffix_draft > 0) sfx.append(outv[(size_t) i]);
+                eos = o.stop_eos && std::find(o.eos_ids.begin(), o.eos_ids.end(), (int64_t) outv[(size_t) i]) != o.eos_ids.end();
+            }
+            if (eos) {
