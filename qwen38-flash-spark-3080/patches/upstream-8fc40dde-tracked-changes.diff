+        cc.device = o.cold_expert_device;
+        cc.port = o.cold_expert_port;
+        cc.gid = o.cold_expert_gid;
+        cc.slots = o.cold_expert_slots;
+        cc.slot_bytes = o.cold_expert_slot_bytes;
