+    impl_->rb = row_bytes;
+    impl_->max_inflight = max_inflight;
+    impl_->slab = (uint8_t*) DirectFile::alloc_aligned((size_t) max_inflight * 2 * PAGE);
+    if (impl_->slab == nullptr) { err = "PleReader: cannot allocate read buffers"; close(); return false; }
+    impl_->inflight.assign(max_inflight, Job{});
+    impl_->free_slots.clear();
+    for (uint32_t s = max_inflight; s-- > 0;) impl_->free_slots.push_back(s);
+    impl_->cache.init(cache_rows, row_bytes);
+    impl_->error.clear();
+    reset_stats();
+    impl_->stop = false;
+    impl_->threaded = io_thread;
+    if (io_thread) {
+        try {
+            impl_->worker = std::thread([this] { impl_->worker_loop(); });
+        } catch (const std::exception& e) {
+            err = std::string("PleReader: cannot create I/O worker: ") + e.what();
+            close();
+            return false;
+        } catch (...) {
+            err = "PleReader: cannot create I/O worker";
+            close();
+            return false;
+        }
+    }
+    return true;
+}
+
+bool PleReader::open_remote(PleRemoteRows* src, uint64_t n_rows, uint64_t cache_rows, std::string& err,
+                            uint32_t row_bytes) {
+    close();
+    if (src == nullptr || n_rows == 0) { err = "PleReader: remote mode needs a row source and a row count"; return false; }
+    impl_->remote = src;
+    impl_->n_rows = n_rows;
+    impl_->rb = row_bytes;
+    impl_->cache.init(cache_rows, row_bytes);
+    impl_->error.clear();
+    reset_stats();
+    return true;
+}
+
+void PleReader::close() {
+    Impl& m = *impl_;
+    if (m.worker.joinable()) {
+        {
+            std::lock_guard<std::mutex> lk(m.mu);
+            m.stop = true;
+            m.queue.clear();                       // unsubmitted work is dropped; in-flight reads still drain
+        }
+        m.cv_work.notify_all();
+        m.file.wake();
+        m.worker.join();
+    }
+    // Outstanding reads must finish before their buffers are released (caller-thread mode, or a worker that
+    // stopped on an error).
+    if (m.file.is_open()) {
+        while (m.free_slots.size() < m.max_inflight) {
+            Completion c[64];
+            const int n = m.file.wait(c, 64, -1);
+            if (n == 0) break;
+            for (int i = 0; i < n; ++i)
+                if (c[i].tag != DirectFile::WAKE_TAG) m.free_slots.push_back((uint32_t) c[i].tag);
+        }
+    }
+    m.file.close();
+    m.remote = nullptr;
+    m.remote_scratch.clear();
+    m.remote_rows.clear();
+    m.remote_idx.clear();
+    DirectFile::free_aligned(m.slab);
+    m.slab = nullptr;
+    m.queue.clear();
+    m.tickets.clear();
+    m.delayed.clear();
+    m.inflight.clear();
+    m.free_slots.clear();
+    m.cache.init(0);
+    m.threaded = false;
+    m.stop = false;
+}
+
+bool PleReader::is_open() const { return impl_->file.is_open() || impl_->remote != nullptr; }
+
+PleReader::Ticket PleReader::issue(const uint32_t* rows, size_t n, uint8_t* out_raw) {
+    Impl& m = *impl_;
+    if (m.remote != nullptr) {
+        // RDMA mode: cache first, then ONE synchronous chained read of the misses (microseconds, not the
+        // SSD's milliseconds).  The ticket completes inside the call; `collect` only checks the error slot.
+        // The lock is the prefill gather's std::async prefetch sharing the tickets map with decode.
+        std::lock_guard<std::mutex> rlk(m.mu);
+        const uint32_t id = m.next_ticket++;
+        if (m.next_ticket == 0) m.next_ticket = 1;
+        TicketState& ts = m.tickets[id];
+        ts.pending = 0;
+        m.remote_rows.clear();
+        m.remote_idx.clear();
+        for (size_t i = 0; i < n; ++i) {
+            uint8_t* dst = out_raw + i * m.rb;
+            ++m.stats.requests;
+            if (rows[i] >= m.n_rows) {
+                std::memset(dst, 0, m.rb);
+                continue;
+            }
+            if (const uint8_t* hit = m.cache.find(rows[i])) {
+                std::memcpy(dst, hit, m.rb);
+                ++m.stats.cache_hits;
+                continue;
+            }
+            m.remote_rows.push_back(rows[i]);
+            m.remote_idx.push_back(i);
+        }
+        if (!m.remote_rows.empty()) {
+            const double issued = now_us();
+            m.remote_scratch.resize(m.remote_rows.size() * m.rb);
+            if (!m.remote->read_rows(m.remote_rows.data(), m.remote_rows.size(), m.remote_scratch.data(),
+                                     m.error)) {
+                return Ticket{id};           // the error slot carries it; `collect` reports it
+            }
+            m.record_latency(now_us() - issued);
+            m.stats.reads += m.remote_rows.size();
+            m.stats.bytes += m.remote_rows.size() * m.rb;
+            for (size_t j = 0; j < m.remote_rows.size(); ++j) {
+                uint8_t* dst = out_raw + m.remote_idx[j] * m.rb;
+                std::memcpy(dst, &m.remote_scratch[j * m.rb], m.rb);
+                m.cache.insert(m.remote_rows[j], &m.remote_scratch[j * m.rb]);
+            }
+        }
+        return Ticket{id};
+    }
+    std::unique_lock<std::mutex> lk(m.mu, std::defer_lock);
+    if (m.threaded) lk.lock();
+    const uint32_t id = m.next_ticket++;
+    if (m.next_ticket == 0) m.next_ticket = 1;
+    TicketState& ts = m.tickets[id];
+    std::unordered_map<uint64_t, size_t> by_page;     // aligned offset -> index in `jobs`
+    std::vector<Job> jobs;
+    for (size_t i = 0; i < n; ++i) {
+        uint8_t* dst = out_raw + i * m.rb;
+        ++m.stats.requests;
+        if (rows[i] >= m.n_rows) {
+            std::memset(dst, 0, m.rb);
+            continue;
+        }
+        if (const uint8_t* hit = m.cache.find(rows[i])) {
+            std::memcpy(dst, hit, m.rb);
+            ++m.stats.cache_hits;
+            continue;
+        }
+        const uint64_t at = m.table_offset + (uint64_t) rows[i] * m.rb;
+        const uint64_t first = at / PAGE * PAGE;
+        const uint32_t length = (uint32_t) ((at + m.rb - 1) / PAGE * PAGE - first + PAGE);
+        auto f = by_page.find(first);
+        if (f != by_page.end()) {
+            Job& j = jobs[f->second];
+            j.length = std::max(j.length, length);
+            j.uses.push_back(Use{rows[i], (uint32_t) (at - first), dst});
+            ++m.stats.dedup_rows;
+            continue;
+        }
+        by_page.emplace(first, jobs.size());
+        Job j;
+        j.offset = first;
+        j.length = length;
+        j.ticket = id;
+        j.uses.push_back(Use{rows[i], (uint32_t) (at - first), dst});
+        jobs.push_back(std::move(j));
+    }
+    // Sorted by offset: prefill chunks then read the SSD in near-sequential order.
+    std::sort(jobs.begin(), jobs.end(), [](const Job& a, const Job& b) { return a.offset < b.offset; });
+    ts.pending = (uint32_t) jobs.size();
+    const bool has_jobs = ts.pending > 0;
+    for (Job& j : jobs) m.queue.push_back(std::move(j));
+    if (m.threaded) {
+        lk.unlock();
+        if (has_jobs) {
+            m.cv_work.notify_one();
+            m.file.wake();                         // in case the worker is blocked in the port
+        }
+    } else if (!m.pump() && m.error.empty()) {
+        m.error = "PleReader: submit failed";
+    }
+    return Ticket{id};
+}
+
+bool PleReader::collect(Ticket t, std::string& err) {
+    Impl& m = *impl_;
+    const double start = now_us();
+    if (m.remote != nullptr) {
+        // The ticket completed inside `issue`; only the bookkeeping and the error slot remain.
+        std::lock_guard<std::mutex> rlk(m.mu);
+        auto it = m.tickets.find(t.id);
+        if (it == m.tickets.end()) { err = "PleReader: unknown ticket"; return false; }
+        m.tickets.erase(it);
+        if (!m.error.empty()) { err = m.error; return false; }
+        m.stats.wait_us += now_us() - start;
+        return true;
+    }
+    if (m.threaded) {
+        std::unique_lock<std::mutex> lk(m.mu);
+        auto it = m.tickets.find(t.id);
+        if (it == m.tickets.end()) { err = "PleReader: unknown ticket"; return false; }
+        m.cv_done.wait(lk, [&] {
+            const auto current = m.tickets.find(t.id);
+            return current == m.tickets.end() || current->second.pending == 0;
+        });
+        it = m.tickets.find(t.id);
+        if (it == m.tickets.end()) { err = "PleReader: unknown ticket"; return false; }
+        if (!m.error.empty()) { err = m.error; return false; }
+        m.stats.wait_us += now_us() - start;
+        m.tickets.erase(it);
+        return true;
+    }
+    auto it = m.tickets.find(t.id);
+    if (it == m.tickets.end()) { err = "PleReader: unknown ticket"; return false; }
+    while (it->second.pending > 0) {
+        const bool drained = m.drain(-1);
+        if (!drained && m.error.empty()) m.error = "PleReader: read failed";
+        it = m.tickets.find(t.id);
+        if (it == m.tickets.end()) { err = "PleReader: unknown ticket"; return false; }
+    }
+    if (!m.error.empty()) { err = m.error; return false; }
+    m.stats.wait_us += now_us() - start;
+    m.tickets.erase(it);
+    return true;
+}
+
+void PleReader::set_injected_delay_us(double delay_us) {
+    std::lock_guard<std::mutex> lk(impl_->mu);
+    impl_->delay_us = delay_us < 0 ? 0 : delay_us;
+}
+const ReaderStats& PleReader::stats() const { return impl_->stats; }
+void PleReader::reset_stats() {
+    impl_->stats = ReaderStats{};
+    impl_->ring_pos = 0;
+}
+uint64_t PleReader::cache_capacity() const { return impl_->cache.sets * WAYS; }
+uint64_t PleReader::cache_size() const { return impl_->cache.used; }
+
+}  // namespace strata::ngram
