+                                            m.pf_gstart.size() * sizeof(int32_t), cudaMemcpyHostToDevice, m.cs);
+                            cudaMemcpyAsync(m.pf_edst_dev, m.pf_edst.data(), (size_t) nh * sizeof(int32_t),
