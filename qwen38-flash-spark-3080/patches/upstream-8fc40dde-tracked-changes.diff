+        w->codes_bytes % alignof(float) != 0 || w->scales_bytes % sizeof(float) != 0 ||
+        (w->scales_bytes / sizeof(float)) % row_groups != 0 ||
+        (w->scales_bytes / sizeof(float)) / row_groups != rows ||
