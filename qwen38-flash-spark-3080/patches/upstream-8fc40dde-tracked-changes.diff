+    // two have nothing in common to optimise.
+    std::fprintf(stderr, "\nper-layer, the attention block (ms).  A `*` marks a QSA layer:\n");
+    double gdn = 0, qsa = 0;
+    int ng = 0, nq = 0;
+    for (int64_t l = 0; l < n_layers && l < 64; ++l) {
+        float ms = 0.0f;
