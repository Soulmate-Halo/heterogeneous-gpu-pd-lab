-constexpr int GMAX = 8;                          // entries per group (tokens routed to one expert in a window)
-constexpr int GU_ROWS = 32;                      // gate/up rows per block: 4 per warp
-constexpr int D_ROWS = 64;                       // down rows per block: 8 per warp
