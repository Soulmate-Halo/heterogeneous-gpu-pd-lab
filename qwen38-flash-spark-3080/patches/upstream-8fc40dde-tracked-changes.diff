+                return 1;
+            }
+            ++rounds;
+            drafts_total += T - 1;
+            drafts_ok += a;
+            ++accepted_hist[(size_t) a];
+            if (from_sfx) { ++sfx_windows; sfx_drafts += T - 1; sfx_ok += a; }
+            bool eos = false;
+            for (int i = 0; i <= a && (int64_t) produced.size() < o.max_new && !eos; ++i) {
