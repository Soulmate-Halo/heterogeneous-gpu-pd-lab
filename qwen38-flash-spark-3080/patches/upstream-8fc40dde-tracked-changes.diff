+            xcache.layer_slot_range(0, lo, hi);
+            std::fprintf(stderr, "                 R4.2g PER-LAYER: each layer owns %lld slots (%lld..%lld).\n",
+                         (long long) (hi - lo), (long long) lo, (long long) (hi - 1));
