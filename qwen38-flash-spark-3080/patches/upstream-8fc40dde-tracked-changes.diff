+                         (long long) strata::core::RDMAExpertTier::kMaxPushTok);
+        }
+        void* borrow = nullptr;
+        uint64_t borrow_bytes = 0;
+        if (!o.no_prefill_borrow && !host_res.empty() && d_res != nullptr) {
