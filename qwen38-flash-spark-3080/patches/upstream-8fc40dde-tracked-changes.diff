-    base_ = (const uint8_t*) view;
-#endif
-    blobs_ = (int64_t) blob_count;
-    n_layers_ = n_layers;
-    n_expert_ = n_expert;
-    mapped_bytes_ = want;
-    layer_offsets_ = std::move(layer_offsets);
-    layer_blob_bytes_ = std::move(layer_blob_bytes);
-    return true;
-}
