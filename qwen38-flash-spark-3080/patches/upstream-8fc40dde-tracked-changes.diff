+            int next = 0;
+            for (const auto& pair : ranked) {
+                if (pair.first < 0 || pair.first >= g.n_layers || pair.second < 0 || pair.second >= g.n_expert ||
+                    xcache.slot_of(pair.first, pair.second) >= 0) continue;
