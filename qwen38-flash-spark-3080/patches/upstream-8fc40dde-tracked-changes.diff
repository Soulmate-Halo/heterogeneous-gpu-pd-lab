+            return 1;
+        }
+        int64_t filled = 0;
+        for (const auto& pr : st.profile) {
+            if (filled >= st.cache.slots()) break;
+            const int32_t slot = st.cache.admit(pr.first, pr.second);
+            if (slot == strata::core::kNotResident) break;
