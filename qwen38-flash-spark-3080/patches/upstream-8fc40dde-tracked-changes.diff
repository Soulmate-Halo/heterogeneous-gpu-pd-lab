-        if (complement_pinned_) (void) cudaFreeHost(complement_arena_);
-        else std::free(complement_arena_);
-    }
-    complement_arena_ = nullptr;
-    complement_host_ = nullptr;
-    complement_device_ = nullptr;
-    complement_bytes_ = 0;
