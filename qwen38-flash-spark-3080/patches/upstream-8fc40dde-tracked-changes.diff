-        __syncthreads();
-        const float kv_col = red[0][c] + red[1][c] + red[2][c] + red[3][c];
-        const float delta = (ht[2 * HK * S + head * S + col] - g * kv_col) * beta[t * HV + head];
-        float o = 0.0f;
-#pragma unroll
