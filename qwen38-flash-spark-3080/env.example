# Copy to .env on each host. Keep real paths and credentials outside Git.
STRATA_SRC_DIR=/opt/qwen38-flash-spark-3080/src
STRATA_BUILD_DIR=/opt/qwen38-flash-spark-3080/build-nvfp4
STRATA_PACK_HOT=/models/strata-pack-hot
STRATA_PACK_COLD=/models/strata-cold-pack
STRATA_DENSE_GGUF=/models/dense.gguf
STRATA_PLE_GGUF=/models/Q2_0-00002.gguf
STRATA_PLE_FP8=/models/ple-fp8.bin
STRATA_PLE_FP8_SCALE=0.00019931793212890625
STRATA_PROFILE=/models/profile.bin
STRATA_TOKEN_FILE=/models/tokens.txt
STRATA_MAX_CONTEXT=16384
STRATA_EXPERT_CACHE=4608
STRATA_REMOTE_HOST=peer-host.example
STRATA_REMOTE_PORT=39580
STRATA_REMOTE_HCA=
STRATA_REMOTE_GID=0
STRATA_REMOTE_SLOTS=4
STRATA_REMOTE_SLOT_BYTES=4194304
STRATA_PREFILL_BACKEND=http://spark-host:8200
STRATA_DECODE_BACKEND=http://gpu-host:8100
STRATA_ROUTER_HOST=0.0.0.0
STRATA_ROUTER_PORT=8400
STRATA_ROUTER_THRESHOLD=4096

