# Qwen3.8 Flash-Next V2 runtime contract; replace angle-bracket values on each host.
STRATA_ROLE=eng
STRATA_RDMA_WORKER_HOST=<spark-rdma-host>
STRATA_RDMA_ENGINE_HOST=<rtx3080-rdma-host>
STRATA_RDMA_WORKER_ENDPOINT=<spark-rdma-host>:39580
STRATA_RDMA_DEVICE=
STRATA_RDMA_GID=0
STRATA_RDMA_SLOTS=4
STRATA_RDMA_SLOT_BYTES=4194304
STRATA_EXPERT_CACHE=4608
STRATA_MAX_CONTEXT=16384
STRATA_KV=fp8
STRATA_PREFILL=auto
STRATA_PF_NVFP4_RESIDENT=1
STRATA_HOT_PACK_DIR=/models/strata-pack-hot
STRATA_COLD_PACK_DIR=/models/strata-cold-pack
STRATA_DENSE_GGUF=/models/dense.gguf
STRATA_PLE_GGUF=/models/Q2_0-00002.gguf
STRATA_PLE_FP8=/models/ple-fp8.bin
STRATA_PLE_FP8_SCALE=0.00019931793212890625
STRATA_PROFILE_BIN=/opt/qwen38-flash-spark-3080/assets/expert-profile-v4.bin
STRATA_ENGINE_HTTP=0.0.0.0:8100
STRATA_WORKER_HTTP=0.0.0.0:8200
STRATA_ROUTER_HTTP=0.0.0.0:8400
STRATA_PREFILL_BACKEND=http://<spark-http-host>:8200
STRATA_DECODE_BACKEND=http://<rtx3080-http-host>:8100
STRATA_ROUTER_THRESHOLD=4096
# 1163.40 measured prefill; 60.25 measured aggregate decode; 240.00 projected V2 target.
