# Qwen3.8-Flash-Next NVFP4 single-host runtime contract (RTX 3080 + AI Max 395).
# Replace angle-bracket values before serving; keep real paths out of Git.
STRATA_ROLE=engine
STRATA_HIPDECODE=1
STRATA_HIPCOLD_LIB=<cache-dir>/hipcold/libstrata_hipdecode.so
FRAC=128
HIPCOLD_SYNC_MODE=block
HIPCOLD_SLOTS=384
STRATA_HTTP_BIND=0.0.0.0:8095
STRATA_HTTP_PORT=8095
STRATA_ENGINE_BIN=<models-dir>/strata/strata
STRATA_EXPERTS_PACK=<models-dir>/experts.bin
STRATA_DENSE_GGUF=<models-dir>/dense.gguf
STRATA_PLE=<models-dir>/ple.bin
STRATA_EMBED=<models-dir>/embedding.bin
STRATA_MTP=<models-dir>/mtp.bin
STRATA_CACHE_DIR=/cache
STRATA_STATE_DIR=/state
STRATA_LOG=/state/engine.log
